rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for zero-trust authentication & authorization
    function isSignedIn() {
      return request.auth != null;
    }

    // Explicitly designated root bootstrap administrator email
    function isDesignatedAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in [
          '10362581@upsamail.edu.gh'
        ];
    }

    // Verified admin document check (requires active role field 'admin')
    function hasAdminDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Server-verified administrative mutation authorization (Phone: 0243324183 / Yaw)
    function isServerAdminWrite() {
      return request.resource.data._cmsAuth != null &&
        request.resource.data._cmsAuth.adminPhone == '0243324183' &&
        request.resource.data._cmsAuth.secret == 'ankobeng_cms_admin_vault_2026_yaw_motors_0243324183_7f9b8c2d1e0a4f5b' &&
        request.resource.data._cmsAuth.timestamp is timestamp &&
        request.time >= request.resource.data._cmsAuth.timestamp &&
        request.time - request.resource.data._cmsAuth.timestamp < duration.value(300, 's');
    }

    // Server-verified administrative document deletion
    function isServerAdminDelete() {
      return resource.data._pendingDelete == true &&
        resource.data._deleteTimestamp is timestamp &&
        request.time >= resource.data._deleteTimestamp &&
        request.time - resource.data._deleteTimestamp < duration.value(60, 's');
    }

    // Unified Administrator authorization boundary
    function isAdmin() {
      return isDesignatedAdminEmail() || hasAdminDoc();
    }

    function isAuthorizedAdminWrite() {
      return isAdmin() || isServerAdminWrite();
    }

    function isAuthorizedAdminDelete() {
      return isAdmin() || isServerAdminDelete();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // ------------------------------------------------------------------------
    // Admins Collection: Strict Privilege-Escalation Prevention
    // - Ordinary authenticated users cannot create, edit, or delete any admin doc.
    // - Only the designated root administrator email can manage /admins docs.
    // - Authenticated users can only read their own record to verify permissions.
    // ------------------------------------------------------------------------
    match /admins/{adminUid} {
      allow read: if isSignedIn() && (request.auth.uid == adminUid || isDesignatedAdminEmail());
      allow create, update, delete: if isDesignatedAdminEmail() && isValidId(adminUid);
    }

    // ------------------------------------------------------------------------
    // Public CMS Content Collections (Public Read, Admin Write)
    // ------------------------------------------------------------------------

    // Products collection: All inventory items
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAuthorizedAdminWrite() && isValidId(productId);
      allow delete: if isAuthorizedAdminDelete() && isValidId(productId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAuthorizedAdminWrite() && isValidId(categoryId);
      allow delete: if isAuthorizedAdminDelete() && isValidId(categoryId);
    }

    // Hero Slides collection
    match /heroSlides/{slideId} {
      allow read: if true;
      allow create, update: if isAuthorizedAdminWrite() && isValidId(slideId);
      allow delete: if isAuthorizedAdminDelete() && isValidId(slideId);
    }

    // Homepage Content document
    match /homepageContent/{docId} {
      allow read: if true;
      allow create, update: if isAuthorizedAdminWrite() && isValidId(docId);
      allow delete: if isAuthorizedAdminDelete() && isValidId(docId);
    }

    // Media Library metadata
    match /media/{mediaId} {
      allow read: if true;
      allow create, update: if isAuthorizedAdminWrite() && isValidId(mediaId);
      allow delete: if isAuthorizedAdminDelete() && isValidId(mediaId);
    }

    // Business Information (Address, Phone numbers, Owner)
    match /businessInfo/{docId} {
      allow read: if true;
      allow create, update: if isAuthorizedAdminWrite() && isValidId(docId);
      allow delete: if isAuthorizedAdminDelete() && isValidId(docId);
    }

    // Settings (WhatsApp ordering configuration)
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isAuthorizedAdminWrite() && isValidId(docId);
      allow delete: if isAuthorizedAdminDelete() && isValidId(docId);
    }

    // Global default-deny for all other arbitrary paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
